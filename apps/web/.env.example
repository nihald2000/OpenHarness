# Base URL of the OpenHarness server (server-side only; never exposed to the browser)
OPENHARNESS_URL=http://127.0.0.1:4096

# Optional bearer token injected by the Next.js proxy when talking to a protected OpenHarness server
OPENHARNESS_SERVER_TOKEN=

# Optional secret used to derive the AES-256-GCM key for the oh_admin session cookie.
# If unset, a random key is generated per web server process.
OPENHARNESS_WEB_SESSION_SECRET=
