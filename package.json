{
  "name": "openharness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "npm run typecheck && (vite build 2>/dev/null || node scripts/verify-frontend.mjs --build)",
    "server": "node --loader ./scripts/ts-loader.mjs packages/server/src/main.ts",
    "sandboxd:build": "bun build --compile --target=bun-linux-x64 packages/sandboxd/src/main.ts --outfile dist/oh-sandboxd",
    "modal:image": "python3 deploy/modal/build_image.py",
    "modal:spike": "node --loader ./scripts/ts-loader.mjs scripts/modal-spike.ts",
    "typecheck": "tsc -p tsconfig.json 2>/dev/null || node scripts/verify-frontend.mjs",
    "typecheck:server": "tsc -p tsconfig.server.json 2>/dev/null || node scripts/verify-frontend.mjs --server",
    "test": "node --loader ./scripts/ts-loader.mjs --test tests/*.test.ts",
    "eval": "node --loader ./scripts/ts-loader.mjs packages/cli/src/index.ts eval examples/demo.eval.jsonl"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.7.0",
    "vite": "^6.2.0"
  }
}
