{
  "name": "openharness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --port 3000",
    "build:web": "vite build",
    "build": "npm run typecheck && npm run build:web",
    "server": "tsx packages/server/src/main.ts",
    "sandboxd:build": "bun build --compile --target=bun-linux-x64 packages/sandboxd/src/main.ts --outfile dist/oh-sandboxd",
    "modal:image": "python3 deploy/modal/build_sandbox_image.py",
    "modal:spike": "tsx scripts/modal-spike.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test": "node --import tsx --test --test-timeout=120000 \"tests/**/*.test.ts\"",
    "eval": "tsx packages/cli/src/index.ts eval examples/demo.eval.jsonl"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "modal": "^0.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.7.0",
    "vite": "^6.2.0"
  }
}
